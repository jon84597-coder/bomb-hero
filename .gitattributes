# 主檔一律 LF（Windows 上 core.autocrlf=true 會把工作檔轉成 CRLF，
# 每個換行 +1 字元 → 單檔體積會多出 ~1.3KB，verify-v34 的 3,350,000 上限就爆了）
bomb-hero/index.html text eol=lf
public/index.html text eol=lf
bomberman-online/public/index.html text eol=lf
bomb-hero/sw.js text eol=lf
public/sw.js text eol=lf
bomberman-online/public/sw.js text eol=lf

# v4.81：測試腳本也鎖 LF。verify-v66 曾因工作檔是 CRLF（行尾 `}\r`）
# 導致字串替換對不上、編輯後語法壞掉，排查了很久。
*.js  text eol=lf
*.mjs text eol=lf
*.json text eol=lf

# v4.79：貼圖一律當二進位處理，避免 git 做任何換行轉換
*.webp binary

# 測試用的 HTML 原型也鎖 LF（避免工作檔 CRLF 讓字串比對出錯）
*.html text eol=lf
